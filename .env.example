# Create a random, long value. This must match Meta's "Xác minh mã" field.
VERIFY_TOKEN=replace-with-a-random-secret

# From Meta Developers > App settings > Basic. Never paste it into chat.
APP_SECRET=replace-with-your-meta-app-secret

# Long random secret used by the internal CRM/review screen when requesting AI suggestions.
INTERNAL_API_KEY=replace-with-a-different-random-secret

# The HTTP port used by the service.
PORT=3000

# Lark Base shadow-review integration. Keep disabled until the Lark app secret
# is entered locally. This app is restricted to the new Messenger AI test table.
LARK_BASE_SYNC_ENABLED=false
LARK_APP_ID=cli_aa1bbe4b78f85ee9
LARK_APP_SECRET=replace-with-your-lark-app-secret
# The Base and table IDs are fixed in source code as a safety allowlist.

# Staff dashboard (/assistant) login via "Đăng nhập bằng Facebook". Runs on
# the same Meta app as the Messenger webhook ("Chat bot"), so it reuses
# APP_SECRET as the Facebook Login app secret unless overridden below.
FACEBOOK_APP_ID=2473856919758911
FACEBOOK_APP_SECRET=
FACEBOOK_LOGIN_CONFIG_ID=
# Must match the deployed public URL exactly (used as the OAuth redirect_uri).
PUBLIC_BASE_URL=https://gia-linh-messenger-webhook.onrender.com
# Comma-separated Facebook user IDs allowed into /assistant. Leave empty only
# for first bootstrap login — while empty, ANY Facebook account can log in.
STAFF_FACEBOOK_IDS=
